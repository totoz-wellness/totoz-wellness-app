generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User model - Core authentication and profile data
/// Supports multiple roles for different platform features
model User {
  id                 String             @id @default(cuid())
  name               String
  age                Int
  email              String             @unique
  password           String
  gender             String
  role               UserRole           @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  articles           Article[]          @relation("AuthoredArticles")
  reviewedArticles   Article[]          @relation("ReviewedArticles")
  children           Child[]
  createdDirectories Directory[]
  growTrackEntries   GrowTrackEntry[]
  kidsCornerData     KidsCorner?
  answers            Answer[]
  moderationActions  ModerationLog[]
  questionVotes      QuestionVote[]
  questions          Question[]
  reportsMade        Report[]           @relation("ReportCreator")
  reportsReceived    Report[]           @relation("ReportedContent")
  stories            Story[]
  storyVotes         StoryVote[]
  refreshTokens      RefreshToken[]
  storyComments      StoryComment[]
  talkEasyFeedback   TalkEasyFeedback[]
  talkEasyMessages   TalkEasyMessage[]

  @@map("users")
}

/// RefreshToken - Stores long-lived refresh tokens for automatic token renewal
/// Enables seamless user experience without forced logouts
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Article model - Mental health articles and resources
/// Supports multi-stage workflow: DRAFT → SUBMITTED → APPROVED → PUBLISHED
model Article {
  id             String        @id @default(cuid())
  title          String
  content        String
  excerpt        String?
  coverImage     String?
  videoUrl       String?
  status         ArticleStatus @default(DRAFT)
  category       String?
  tags           String[]
  readTime       Int?
  slug           String?       @unique
  authorId       String
  reviewerId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  reviewFeedback String?
  author         User          @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer       User?         @relation("ReviewedArticles", fields: [reviewerId], references: [id])

  @@map("articles")
}

/// Directory model - Mental health services and organizations
/// Searchable directory of counselors, helplines, NGOs, etc.
model Directory {
  id              String        @id @default(cuid())
  name            String
  type            DirectoryType
  description     String
  excerpt         String?
  phone           String?
  email           String?
  website         String?
  address         String?
  city            String?
  county          String?
  region          String?
  coordinates     String?
  operatingHours  String?
  languages       String[]
  specializations String[]
  isVerified      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  slug            String        @unique
  tags            String[]
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  latitude        Float?
  longitude       Float?
  createdBy       User          @relation(fields: [createdById], references: [id])

  @@map("directories")
}

/// TalkEasy Message - Individual chat conversations with AI
/// Tracks sentiment, topics, and provides resource recommendations
model TalkEasyMessage {
  id                     String   @id @default(cuid())
  userId                 String
  message                String
  response               String
  sentiment              String?
  timestamp              DateTime @default(now())
  sessionId              String?
  conversationTurn       Int?
  detectedKeywords       String[] @default([])
  detectedTopics         String[] @default([])
  emotionalIntensity     String?
  messageLength          Int?
  modelVersion           String?
  primaryCategory        String?
  processingTimeMs       Int?
  promptVersion          String   @default("1.0")
  recommendedArticles    String[] @default([])
  recommendedDirectories String[] @default([])
  resourcesRequested     Boolean  @default(false)
  responseLength         Int?
  secondaryCategory      String?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
  @@index([sentiment])
  @@index([primaryCategory])
  @@index([emotionalIntensity])
  @@index([userId, sessionId])
  @@index([timestamp, primaryCategory])
  @@map("talkeasy_messages")
}

/// TalkEasy Analytics - Daily aggregated metrics
/// Pre-calculated statistics for dashboard performance
model TalkEasyAnalytics {
  id                     String   @id @default(cuid())
  date                   DateTime @unique
  totalMessages          Int      @default(0)
  uniqueUsers            Int      @default(0)
  crisisCount            Int      @default(0)
  positiveCount          Int      @default(0)
  negativeCount          Int      @default(0)
  neutralCount           Int      @default(0)
  categoryBreakdown      Json
  topicTrends            Json
  articlesRecommended    Int      @default(0)
  directoriesRecommended Int      @default(0)
  avgProcessingTime      Float?
  avgMessageLength       Float?
  avgResponseLength      Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([date])
  @@map("talkeasy_analytics")
}

/// TalkEasy Training Data - Anonymized data for AI training
/// Prepares high-quality conversations for model improvement
model TalkEasyTrainingData {
  id                 String   @id @default(cuid())
  anonymizedMessage  String
  anonymizedResponse String
  sentiment          String
  primaryCategory    String
  emotionalIntensity String
  topics             String[] @default([])
  keywords           String[] @default([])
  qualityScore       Float?
  humanReviewed      Boolean  @default(false)
  includeInTraining  Boolean  @default(true)
  originalTimestamp  DateTime
  conversationTurn   Int?
  createdAt          DateTime @default(now())

  @@index([primaryCategory])
  @@index([sentiment])
  @@index([includeInTraining])
  @@index([qualityScore])
  @@map("talkeasy_training_data")
}

/// TalkEasy Feedback - User ratings and feedback
/// Helps improve AI response quality
model TalkEasyFeedback {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  rating    Int
  helpful   Boolean?
  feedback  String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
  @@index([rating])
  @@map("talkeasy_feedback")
}

/// ParentCircle Category - Organizes questions and stories
/// Supports questions-only, stories-only, or both
model ParentCircleCategory {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String?
  type        ContentType
  icon        String?
  color       String?
  order       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  questions   Question[]
  stories     Story[]

  @@index([type])
  @@index([isActive])
  @@map("parentcircle_categories")
}

/// Question - Parent questions seeking advice
/// Supports anonymous posting and community/expert answers
model Question {
  id             Int                  @id @default(autoincrement())
  title          String?
  content        String
  slug           String?              @unique
  categoryId     Int
  createdBy      String?
  authorName     String?
  status         ContentStatus        @default(PENDING)
  views          Int                  @default(0)
  helpfulCount   Int                  @default(0)
  isPinned       Boolean              @default(false)
  isFeatured     Boolean              @default(false)
  tags           String[]             @default([])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  approvedAt     DateTime?
  rejectedAt     DateTime?
  answers        Answer[]
  moderationLogs ModerationLog[]
  votes          QuestionVote[]
  category       ParentCircleCategory @relation(fields: [categoryId], references: [id])
  author         User?                @relation(fields: [createdBy], references: [id])
  reports        Report[]

  @@index([status])
  @@index([categoryId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([isPinned])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@map("parentcircle_questions")
}

/// Answer - Expert and community responses to questions
/// Distinguishes between verified professionals and community members
model Answer {
  id           Int      @id @default(autoincrement())
  content      String
  questionId   Int
  createdBy    String
  isVerified   Boolean  @default(false)
  isAccepted   Boolean  @default(false)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([createdBy])
  @@index([isVerified])
  @@index([createdAt])
  @@map("parentcircle_answers")
}

/// Story - Personal experiences shared by parents
/// Supports anonymous sharing for sensitive topics
model Story {
  id             Int                   @id @default(autoincrement())
  title          String?
  content        String
  slug           String?               @unique
  categoryId     Int?
  createdBy      String?
  authorName     String?
  status         ContentStatus         @default(PENDING)
  views          Int                   @default(0)
  likesCount     Int                   @default(0)
  isFeatured     Boolean               @default(false)
  tags           String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  approvedAt     DateTime?
  rejectedAt     DateTime?
  moderationLogs ModerationLog[]
  reports        Report[]
  category       ParentCircleCategory? @relation(fields: [categoryId], references: [id])
  author         User?                 @relation(fields: [createdBy], references: [id])
  votes          StoryVote[]
  comments       StoryComment[]

  @@index([status])
  @@index([categoryId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@map("parentcircle_stories")
}

/// StoryComment - Community comments on stories
/// Enables discussion and support on personal stories
/// Requires moderation like other user-generated content
model StoryComment {
  id         Int           @id @default(autoincrement())
  content    String
  storyId    Int
  createdBy  String?
  authorName String?
  status     CommentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User?         @relation(fields: [createdBy], references: [id])
  story      Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@index([status, storyId])
  @@map("story_comments")
}

/// QuestionVote - Helpful/Not Helpful votes on questions
model QuestionVote {
  id         Int      @id @default(autoincrement())
  questionId Int
  userId     String
  isHelpful  Boolean
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionId])
  @@index([userId])
  @@map("parentcircle_question_votes")
}

/// StoryVote - Likes on stories (simple like/unlike)
model StoryVote {
  id        Int      @id @default(autoincrement())
  storyId   Int
  userId    String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
  @@map("parentcircle_story_votes")
}

/// Report - User-generated reports for inappropriate content
/// Supports reporting questions, stories, and answers
model Report {
  id             Int               @id @default(autoincrement())
  contentType    ReportableContent
  contentId      Int
  questionId     Int?
  storyId        Int?
  reason         String
  details        String?
  reportedBy     String
  reportedUserId String?
  status         ReportStatus      @default(PENDING)
  resolution     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  question       Question?         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reporter       User              @relation("ReportCreator", fields: [reportedBy], references: [id], onDelete: Cascade)
  reportedUser   User?             @relation("ReportedContent", fields: [reportedUserId], references: [id])
  story          Story?            @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([contentType])
  @@index([reportedBy])
  @@index([createdAt])
  @@map("parentcircle_reports")
}

/// ModerationLog - Audit trail for all moderation actions
/// Tracks who did what and when for accountability
model ModerationLog {
  id             Int              @id @default(autoincrement())
  contentType    ModerableContent
  contentId      Int
  questionId     Int?
  storyId        Int?
  action         ModerationAction
  previousStatus ContentStatus?
  newStatus      ContentStatus
  moderatorId    String
  reason         String?
  notes          String?
  createdAt      DateTime         @default(now())
  moderator      User             @relation(fields: [moderatorId], references: [id])
  question       Question?        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  story          Story?           @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([moderatorId])
  @@index([contentType])
  @@index([action])
  @@index([createdAt])
  @@map("parentcircle_moderation_logs")
}

/// ParentCircle Analytics - Daily aggregated community metrics
/// Pre-calculated for dashboard performance
model ParentCircleAnalytics {
  id                 Int      @id @default(autoincrement())
  date               DateTime @unique
  questionsSubmitted Int      @default(0)
  storiesSubmitted   Int      @default(0)
  questionsApproved  Int      @default(0)
  storiesApproved    Int      @default(0)
  questionsRejected  Int      @default(0)
  storiesRejected    Int      @default(0)
  answersPosted      Int      @default(0)
  uniqueContributors Int      @default(0)
  anonymousRatio     Float?
  totalViews         Int      @default(0)
  totalVotes         Int      @default(0)
  avgModerationTime  Float?
  topCategories      Json
  popularTags        Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  commentsApproved   Int      @default(0)
  commentsRejected   Int      @default(0)
  commentsSubmitted  Int      @default(0)

  @@index([date])
  @@map("parentcircle_analytics")
}

/// GrowTrack Entry - Caregivers track moods, behaviors, and triggers
/// Can track for themselves (SELF) or their children (CHILD)
model GrowTrackEntry {
  id                String            @id @default(cuid())
  userId            String
  mood              String
  moodIntensity     Int
  triggers          String[]          @default([])
  notes             String?
  recordedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  behaviors         String[]          @default([])
  trackedPersonName String?
  trackedPersonType TrackedPersonType @default(SELF)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@index([trackedPersonType])
  @@index([userId, trackedPersonType, trackedPersonName])
  @@index([userId, recordedAt])
  @@map("growtrack_entries")
}

/// Child - Individual child profiles under parent account
/// One parent can manage multiple children
model Child {
  id           String             @id @default(cuid())
  name         String
  age          Int
  avatarEmoji  String             @default("😊")
  parentId     String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  activityLogs ChildActivityLog[]
  buddyChats   ChildBuddyChat[]
  moodLogs     ChildMoodLog[]
  progress     ChildProgress?
  worries      ChildWorry[]
  parent       User               @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([parentId, isActive])
  @@map("children")
}

/// Child Progress - Gamification & streak tracking
model ChildProgress {
  id             String    @id @default(cuid())
  childId        String    @unique
  stickers       String[]  @default([])
  streak         Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_progress")
}

/// Child Mood Log - Track emotional state over time
/// Parents see trends, not individual entries
model ChildMoodLog {
  id        String   @id @default(cuid())
  childId   String
  mood      String
  timestamp DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([timestamp])
  @@index([childId, timestamp])
  @@map("child_mood_logs")
}

/// Child Worry - Encrypted worry box entries
/// Parents can see count, not content (privacy-first)
model ChildWorry {
  id               String   @id @default(cuid())
  childId          String
  encryptedContent String
  createdAt        DateTime @default(now())
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_worries")
}

/// Child Buddy Chat - AI conversation history
/// Parents see AI-generated summaries, full history available on request
model ChildBuddyChat {
  id            String   @id @default(cuid())
  childId       String
  sessionId     String?
  userMessage   String
  buddyResponse String
  sentiment     String?
  isFlagged     Boolean  @default(false)
  flagReason    String?
  timestamp     DateTime @default(now())
  child         Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([sessionId])
  @@index([isFlagged])
  @@map("child_buddy_chats")
}

/// Child Activity Log - Track games, zones, and engagement
model ChildActivityLog {
  id              String   @id @default(cuid())
  childId         String
  activityType    String
  activityName    String
  zone            String
  stickerEarned   String?
  durationSeconds Int?
  completedAt     DateTime @default(now())
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([completedAt])
  @@index([childId, completedAt])
  @@map("child_activity_logs")
}

/// Legacy KidsCorner model - Deprecated, will be removed after migration
model KidsCorner {
  id                  String    @id @default(cuid())
  userId              String    @unique
  stickers            String[]  @default([])
  streak              Int       @default(0)
  worries             String[]  @default([])
  lastMood            String?
  lastMoodDate        DateTime?
  completedActivities String[]  @default([])
  lastActiveDate      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActiveDate])
  @@map("kids_corner")
}

/// User Role - Hierarchical permission system
enum UserRole {
  USER
  CONTENT_WRITER
  CONTENT_LEAD
  SUPER_ADMIN
  MODERATOR
}

/// Article Status - Content workflow stages
enum ArticleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// Directory Type - Service categories
enum DirectoryType {
  NGO
  COUNSELOR
  HELPLINE
  SUPPORT_GROUP
  HOSPITAL
  CLINIC
  THERAPIST
  PSYCHIATRIST
  COMMUNITY_CENTER
  ONLINE_SERVICE
}

/// Content Status - ParentCircle content workflow
enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

/// Comment Status - Story comment moderation
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Content Type - Category applicability
enum ContentType {
  QUESTION
  STORY
  BOTH
}

/// Reportable Content - What can be reported
enum ReportableContent {
  QUESTION
  STORY
  ANSWER
  COMMENT
}

/// Moderable Content - What requires moderation
enum ModerableContent {
  QUESTION
  STORY
  COMMENT
}

/// Report Status - Report lifecycle
enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

/// Moderation Action - Types of moderator actions
enum ModerationAction {
  APPROVE
  REJECT
  ARCHIVE
  RESTORE
  EDIT
  PIN
  UNPIN
  FEATURE
  UNFEATURE
}

/// Tracked Person Type - Who is being tracked
enum TrackedPersonType {
  SELF
  CHILD
}
